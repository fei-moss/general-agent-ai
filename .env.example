# Jenkins production template. Jenkins must render every ${KEY} before deploy.
# Never commit the rendered .env or real credentials.

# ===== Compose / HTTP entrypoint =====
APP_BIND_ADDR=${APP_BIND_ADDR}
APP_PORT=${APP_PORT}
APP_IMAGE_TAG=latest
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# ===== External database / middleware =====
DB_URL=${DB_URL}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_S=1800
REDIS_URL=${REDIS_URL}
CELERY_BROKER_URL=${CELERY_BROKER_URL}
CELERY_RESULT_BACKEND=${CELERY_RESULT_BACKEND}

# ===== Provider selection and credentials =====
LLM_PROVIDER=${LLM_PROVIDER}
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_API_KEY_FILE=${OPENAI_API_KEY_FILE}
OPENAI_MODEL=${OPENAI_MODEL}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_API_KEY_FILE=${ANTHROPIC_API_KEY_FILE}
ANTHROPIC_MODEL=${ANTHROPIC_MODEL}
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=${QWEN_MODEL}
DASHSCOPE_API_KEY=${DASHSCOPE_API_KEY}
DASHSCOPE_API_KEY_FILE=${DASHSCOPE_API_KEY_FILE}
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=${ZAI_MODEL}
ZAI_API_KEY=${ZAI_API_KEY}
ZAI_API_KEY_FILE=${ZAI_API_KEY_FILE}
ZAI_API_KEYS_FILE=${ZAI_API_KEYS_FILE}
ZAI_THINKING_TYPE=enabled
ZAI_REASONING_EFFORT=max
ZAI_TOOL_STREAM=true
GEMINI_MODEL=${GEMINI_MODEL}
GEMINI_API_KEY=${GEMINI_API_KEY}
GEMINI_API_KEY_FILE=${GEMINI_API_KEY_FILE}
LITELLM_MODEL=${LITELLM_MODEL}
LITELLM_FALLBACKS=${LITELLM_FALLBACKS}

# ===== Production safety and runtime =====
PRODUCTION_MODE=true
ALLOW_MOCK_PROVIDER=false
PROVIDER_SECRET_STRICT=true
RATE_LIMIT_PER_MIN=60
MAX_TURNS=10
RETRIEVAL_TOP_K=5
REQUEST_TIMEOUT_S=60
CHAT_RUNTIME_MODE=auto
CHAT_BEHAVIOR_PROFILE=ask_this_agent
REALTIME_RUNNER_MAX_CONCURRENCY=1000
PROVIDER_RATE_LIMIT_ENABLED=true
PROVIDER_RATE_LIMIT_FAIL_OPEN=false
PROVIDER_RATE_LIMITS_JSON={}
PROVIDER_KEY_POOL_FILE=${PROVIDER_KEY_POOL_FILE}
PROVIDER_KEY_POOL_SCOPE=account
PROVIDER_KEY_POOL_STRATEGY=least_wait_round_robin
PROVIDER_DEFAULT_RPM=60
PROVIDER_DEFAULT_TPM=60000
PROVIDER_DEFAULT_MAX_OUTPUT_TOKENS=4096
PROVIDER_REALTIME_PREFLIGHT_TIMEOUT_MS=100
PROVIDER_REALTIME_GATE_WAIT_BUDGET_MS=1000
PROVIDER_REALTIME_DEGRADE_TO_BATCH=true
RUN_MAX_RUNTIME_S=300
STREAM_MAXLEN=1000
STREAM_TTL_S=86400
METRICS_ENABLED=true
REAPER_ENABLED=true
REAPER_INTERVAL_S=30
REAPER_STALE_AFTER_S=300
REAPER_MAX_ATTEMPTS=3
WORKER_POOL=prefork
WORKER_CONCURRENCY=2

# ===== Marketplace private dependency =====
INTERNAL_CONNECT_NETWORK=${INTERNAL_CONNECT_NETWORK}
MARKETPLACE_AI_BASE_URL=${MARKETPLACE_AI_BASE_URL}
MARKETPLACE_AI_TIMEOUT_S=8

# ===== RAG / Embedding =====
RAG_ENABLED=true
RAG_VECTOR_STORE=pgvector
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
RAG_QUERY_TIMEOUT_MS=1500
RAG_SCORE_THRESHOLD=0.0
RAG_MAX_CONTEXT_CHARS=6000
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_INDEX_VERSION=v1
RAG_METADATA_MAX_BYTES=8192
RAG_ADMIN_USER_IDS=${RAG_ADMIN_USER_IDS}
RAG_DEFAULT_KNOWLEDGE_BASE_ID=${RAG_DEFAULT_KNOWLEDGE_BASE_ID}
RAG_INTERNAL_OWNER_USER_ID=${RAG_INTERNAL_OWNER_USER_ID}
RAG_ALLOW_CLIENT_KNOWLEDGE_BASE_ID=false
EMBEDDING_PROVIDER=${EMBEDDING_PROVIDER}
EMBEDDING_MODEL=${EMBEDDING_MODEL}
EMBEDDING_DIM=256
EMBEDDING_API_KEY=${EMBEDDING_API_KEY}
EMBEDDING_API_KEY_FILE=${EMBEDDING_API_KEY_FILE}
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_S=30
